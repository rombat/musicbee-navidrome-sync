{
  "name": "musicbee-navidrome-sync",
  "version": "0.0.0-semantically-released",
  "description": "sync ratings and playcount from musicbee db to navidrome db",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "fullSync": "NODE_NO_WARNINGS=1 node index.js fullSync",
    "albumsSync": "NODE_NO_WARNINGS=1 node index.js albumsSync",
    "artistsSync": "NODE_NO_WARNINGS=1 node index.js artistsSync",
    "build": "sh ./build.sh",
    "build-bundle": "node build.config.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_NO_WARNINGS=1 tsx --test test/*.js test/*.ts"
  },
  "author": "rombat",
  "license": "GNU GPL V3.0",
  "dependencies": {
    "camelcase": "^9.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "csvtojson": "^2.0.14",
    "dayjs": "^1.11.20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.0.0",
    "@yao-pkg/pkg": "^6.13.1",
    "esbuild": "^0.25.9",
    "semantic-release": "^25.0.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.17.0 <23.0.0"
  },
  "private": true
}
